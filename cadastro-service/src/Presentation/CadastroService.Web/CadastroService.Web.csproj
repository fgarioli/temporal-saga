<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Container "web": a API REST. Registra e consulta os cadastros; não conhece a saga. Referencia só o IoC. -->
  <PropertyGroup>
    <RootNamespace>CadastroService.Presentation.Web</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Infrastructure/CadastroService.IoC/CadastroService.IoC.csproj" />
  </ItemGroup>
</Project>
