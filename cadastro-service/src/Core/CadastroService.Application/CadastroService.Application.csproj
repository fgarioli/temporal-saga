<Project Sdk="Microsoft.NET.Sdk">
  <!-- Casos de uso, portas de saída e a saga (orquestração pura, sem o motor que a executa). Depende só do Domain. -->
  <PropertyGroup>
    <RootNamespace>CadastroService.Core.Application</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../CadastroService.Domain/CadastroService.Domain.csproj" />
  </ItemGroup>
</Project>
