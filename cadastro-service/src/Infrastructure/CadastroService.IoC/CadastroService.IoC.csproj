<Project Sdk="Microsoft.NET.Sdk">
  <!-- Composition root: liga as portas do Application às implementações do Infrastructure. Web e Worker referenciam só este projeto. -->
  <PropertyGroup>
    <RootNamespace>CadastroService.Infrastructure.IoC</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Core/CadastroService.Application/CadastroService.Application.csproj" />
    <ProjectReference Include="../CadastroService.Infrastructure/CadastroService.Infrastructure.csproj" />
  </ItemGroup>
</Project>
